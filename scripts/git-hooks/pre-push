#!/usr/bin/env bash
# Full CI-style gate before code leaves the machine.
# Enable with: make hooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

status=0
note() { printf '%s\n' "$*" >&2; }

zero=0000000000000000000000000000000000000000
has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	has_update=1
	: "$local_ref" "$remote_ref" "$remote_sha"
done

# Deletion-only push has nothing to validate.
if [ "$has_update" -eq 0 ]; then
	exit 0
fi

# Called directly, not via `make lint`: that target depends on setup-tools,
# which runs `go install ...@latest` (network + version drift against CI).
if command -v golangci-lint >/dev/null 2>&1; then
	golangci-lint run -c .golangci.yaml ./... || status=1
else
	note "golangci-lint not installed, skipping lint (make setup-tools)"
fi

go test ./... || status=1

# Full-history scan: ~1s at this repo size. If history grows past a few seconds,
# narrow it to the pushed range with --log-opts.
if command -v gitleaks >/dev/null 2>&1; then
	gitleaks git --redact --no-banner || status=1
else
	# Fail closed. gofmt/golangci-lint skipping is recoverable — CI re-runs them.
	# A skipped secret scan is not: the push proceeds unscanned and a leaked
	# credential is already published by the time anyone notices.
	note "gitleaks is required but not installed: brew install gitleaks"
	note "to bypass deliberately: git push --no-verify"
	status=1
fi

exit "$status"
