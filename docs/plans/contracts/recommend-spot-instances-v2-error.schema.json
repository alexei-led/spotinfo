{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexei-led/spotinfo/schemas/recommend-spot-instances-v2-error.schema.json",
  "title": "recommend_spot_instances error payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "message", "cloud"],
  "properties": {
    "schema_version": {"const": "spotinfo.error/v1"},
    "code": {
      "type": "string",
      "enum": ["INVALID_ARGUMENT", "UNSUPPORTED_CAPABILITY", "DATA_UNAVAILABLE", "NO_CANDIDATES", "INTERNAL"]
    },
    "message": {"type": "string", "minLength": 1},
    "cloud": {"type": ["string", "null"]}
  }
}
