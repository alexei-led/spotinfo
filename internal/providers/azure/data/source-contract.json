  "expected_fields": [
    "request filter: serviceName eq 'Virtual Machines' and armRegionName eq '<region>' and priceType eq 'Consumption'",
    "request query: api-version=2023-01-01-preview, currencyCode=USD",
    "response envelope: Items array, NextPageLink string, Count integer",
    "response row: serviceName = Virtual Machines",
    "response row: type = Consumption",
    "response row: unitOfMeasure = 1 Hour",
    "response row: currencyCode = USD",
    "response row: retailPrice = plain decimal number, no exponent",
    "response row: armSkuName = <vm size>, required for a row to be used",
    "response row: armRegionName = <region>",
    "response row: effectiveStartDate = RFC 3339 timestamp",
    "response row: effectiveEndDate = RFC 3339 timestamp, absent while the interval is in force",
    "spot classification: skuName ends with ' Spot'",
    "excluded classification: skuName ends with ' Low Priority', the legacy Batch meter",
    "windows exclusion: productName contains 'Windows'",
    "cloud services exclusion: productName contains 'Cloud Services' or 'CloudServices', the legacy PaaS product published under the same armSkuName at a different rate",
    "size page table header: Size Name | vCPUs (Qty.) | Memory (GiB) or Memory (GB); both label gibibytes and carry identical figures for equivalent sizes",
    "size page size cell: ^Standard_[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*$",
    "size page parts table row: Processor | <range> vCPUs | <model> [x86-64] or [Arm64] or [ARM-64]"
  ],
